# ========= AgentFlow Backend Dev Config =========
# Copy to apps/api/.env or set as environment variables.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database - leave blank to use SQLite in ./data/agentflow.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/agentflow

# Directories
# 默认 {repo}/data（库 + .secret.key 都在这里）。Electron/打包时由外层显式指定。
# DATA_DIR=/path/to/agentflow/data

# CORS (dev only)
# 前端经 Vite 代理访问（同源），一般无需改这里；直连后端调试时才需要放行来源。
CORS_ORIGINS=["http://localhost:5174"]
# 放行本地任意端口（Vite 端口被占用会自动递增）。生产环境必须留空。
CORS_ORIGIN_REGEX=^(http://localhost|http://127[.]0[.]0[.]1)(:[0-9]+)?$

# Engine
ENGINE_MAX_CONCURRENCY=4
RUN_RETENTION=200
DEFAULT_TIMEOUT=120

# Mount frontend dist when running in prod mode
# MOUNT_FRONTEND=true
