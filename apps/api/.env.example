# ========= AgentFlow Backend Dev Config =========
# Copy to apps/api/.env or set as environment variables.

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database - leave blank to use SQLite in ./data/agentflow.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/agentflow

# Directories (default: {repo}/data)
# DATA_DIR=/path/to/agentflow/data
# SECRET_FILE=/path/to/agentflow/data/.secret.key

# CORS (dev only)
CORS_ORIGINS=["http://localhost:5173"]

# Engine
ENGINE_MAX_CONCURRENCY=4
RUN_RETENTION=200
DEFAULT_TIMEOUT=120

# Mount frontend dist when running in prod mode
# MOUNT_FRONTEND=true
