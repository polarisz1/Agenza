# Agenza Docker Compose 部署配置
# 复制到仓库根目录：cp deploy/.env.example .env

# PostgreSQL 密码（请改成长随机值，避免 #、空格等需要转义的字符）
POSTGRES_PASSWORD=change-me-strong-password

# JWT 签名密钥（至少 32 字符；可用 `openssl rand -hex 32` 生成）
JWT_SECRET=change-me-to-a-long-random-string

# 首个用户始终允许注册；之后是否开放注册
ALLOW_REGISTRATION=false

# 对外端口
APP_PORT=8000
