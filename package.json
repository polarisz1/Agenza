{
  "name": "agentflow",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@agentflow/web",
    "dev:api": "uv run --directory apps/api python -m app.run",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@agentflow/web",
    "lint": "turbo run lint",
    "lint:api": "uv run --directory apps/api ruff check src tests",
    "format": "turbo run format",
    "format:check": "uv run --directory apps/api ruff format --check src tests && pnpm --filter @agentflow/web format:check",
    "typecheck": "pnpm --filter @agentflow/web typecheck",
    "test": "uv run --directory apps/api pytest -q",
    "test:web": "pnpm --filter @agentflow/web test",
    "e2e": "pnpm build:web && playwright test",
    "check": "pnpm lint && pnpm lint:api && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:web && pnpm contracts:check",
    "contracts:generate": "node packages/contracts/scripts/generate.mjs",
    "contracts:build": "node node_modules/openapi-typescript/bin/cli.js packages/contracts/openapi.yaml -o packages/contracts/src/generated/index.ts",
    "contracts:check": "node packages/contracts/scripts/check.mjs",
    "pack": "bash tools/scripts/pack-release.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "openapi-typescript": "^7.4.3",
    "turbo": "^2.1.3"
  }
}
